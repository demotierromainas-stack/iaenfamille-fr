# Hébergement Infomaniak (Apache) — site exporté en statique par Next.js.

# Une seule adresse : https://iaenfamille.fr. Le http et le www y sont
# redirigés (301), pour les visiteurs comme pour Google. Méthode recommandée
# par Infomaniak ; si une boucle de redirection apparaît un jour, remplacer
# la condition HTTPS par : RewriteCond %{HTTP:X-Forwarded-Proto} !https
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://iaenfamille.fr%{REQUEST_URI} [R=301,L]

  # Offre retirée : l'ancienne page des cours en ligne renvoie à l'accueil.
  RewriteRule ^cours-en-ligne(/.*)?$ https://iaenfamille.fr/ [R=301,L]
</IfModule>

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html

# Le .env de contact.php contient la clé Resend : jamais servi.
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  # Fichiers de build nommés par empreinte : cache d'un an.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  # Pages HTML : toujours revalidées, pour que les mises à jour se voient.
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Images et animations : noms stables, cache d'une semaine.
  <FilesMatch "\.(webp|png|jpe?g|svg|ico|json|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json image/svg+xml
</IfModule>
